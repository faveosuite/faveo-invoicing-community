{
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "latest",
    "@vue/vue3-jest": "latest",
    "babel-jest": "29",
    "jest": "29",
    "jest-environment-jsdom": "latest",
    "laravel-vite-plugin": "^2.1.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "pinia": "^3.0.4",
    "vue": "3",
    "vue-router": "4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.vue$": "@vue/vue3-jest",
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/resources/js/$1"
    },
    "setupFilesAfterFramework": [
      "<rootDir>/resources/js/tests/setup.js"
    ],
    "testMatch": [
      "**/resources/js/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "resources/js/**/*.{js,vue}",
      "!resources/js/tests/**"
    ]
  }
}
