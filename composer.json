{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/slavka041/mailchimp-api-v3"
        },
        {
            "type": "vcs",
            "url": "https://github.com/ladybirdweb/clockwork.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "ext-zip": "*",
        "ext-intl": "*",
        "bacon/bacon-qr-code": "^v3.0.3",
        "bugsnag/bugsnag-laravel": "^v2.29.0",
        "cartalyst/stripe-laravel": "^v17.0.0",
        "coconutcraig/laravel-postmark": "^v3.3.1",
        "creativeorange/gravatar": "^v1.0.25",
        "darryldecode/cart": "^4.2.6",
        "endroid/qr-code-bundle": "^6.1.0",
        "ezyang/htmlpurifier": "^v4.19.0",
        "geoip2/geoip2": "^v3.3.0",
        "graham-campbell/markdown": "^v16.0.0",
        "guzzlehttp/guzzle": "^7.10.0",
        "itsgoingd/clockwork": "dev-master",
        "laravel/framework": "^v12.48.1",
        "laravel/helpers": "^1.8",
        "laravel/horizon": "^v5.42.0",
        "laravel/passport": "^v13.4.3",
        "laravel/pulse": "^v1.5.0",
        "laravel/socialite": "^v5.24.2",
        "laravel/tinker": "^v2.11.0",
        "laravel/ui": "^v4.6.1",
        "league/commonmark": "^2.8.0",
        "league/flysystem-aws-s3-v3": "^3.30.1",
        "maatwebsite/excel": "^3.1.67",
        "monolog/monolog": "^3.10.0",
        "php-mock/php-mock": "^2.6.2",
        "pion/laravel-chunk-upload": "^v1.5.6",
        "pipedrive/pipedrive": "^14.6.0",
        "pragmarx/google2fa-laravel": "^v2.3.0",
        "pragmarx/google2fa-qrcode": "^v3.0.1",
        "predis/predis": "^v3.3.0",
        "razorpay/razorpay": "^2.9.2",
        "slavka/mailchimp-apiv3": "dev-master#d4c99f784559ae791eece8341faafdd79d41a353",
        "spatie/laravel-activitylog": "^4.10.2",
        "spatie/laravel-csp": "^3.21.0",
        "spatie/laravel-html": "^3.12.3",
        "spatie/laravel-pdf": "^1.8",
        "spatie/laravel-referer": "^1.9.1",
        "stripe/stripe-php": "^v19.2.0",
        "symfony/google-mailer": "^v8.0.0",
        "symfony/http-client": "^v8.0.3",
        "symfony/mailer": "^v7.4.3",
        "symfony/mailgun-mailer": "^v8.0.0",
        "symfony/mime": "^v7.4.0",
        "symfony/polyfill-iconv": "^v1.33.0",
        "symfony/templating": "^v6.4.24",
        "symfony/twig-bundle": "^v8.0.3",
        "torann/geoip": "^3.0.9",
        "twig/cssinliner-extra": "^v3.22.0",
        "twig/extra-bundle": "^v3.22.2",
        "twig/twig": "^v3.22.2",
        "vemcogroup/laravel-sparkpost-driver": "^5.1.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^v3.16.3",
        "barryvdh/laravel-ide-helper": "^v3.6.1",
        "beyondcode/laravel-query-detector": "^2.1.0",
        "fakerphp/faker": "^v1.24.1",
        "laravel/dusk": "^v8.3.4",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^v8.8.3",
        "phpunit/php-code-coverage": "^12.5.2",
        "phpunit/phpunit": "^12.5.6",
        "spatie/laravel-ignition": "^2.10.0",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "autoload": {
        "exclude-from-classmap": [
            "/vendor/monolog/*"
        ],
        "files": [
            "app/Http/helpers.php"
        ],
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        }
    },
    "scripts": {
        "filter-test": "php vendor/phpunit/phpunit/phpunit --colors=always --filter",
        "all-test": "php vendor/phpunit/phpunit/phpunit",
        "all-unit-test": "php vendor/phpunit/phpunit/phpunit --testsuite Unit",
        "backend-test": "php vendor/phpunit/phpunit/phpunit --colors=always --testsuite backend",
        "group-test": "php vendor/phpunit/phpunit/phpunit --colors=always --group",
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "endroid/installer": true,
            "php-http/discovery": true
        }
    }
}
