{
    "name": "coconutcraig/laravel-postmark",
    "type": "library",
    "description": "Laravel package for sending mail via the Postmark API",
    "keywords": [
        "wildbit",
        "postmark",
        "laravel",
        "mail",
        "email"
    ],
    "homepage": "https://github.com/craigpaul/laravel-postmark",
    "license": "MIT",
    "authors": [
        {
            "name": "Craig Paul",
            "email": "craig.paul91@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "ext-gd": "*",
        "fakerphp/faker": "^1.17",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.5.3|^12.5.12|^13.0"
    },
    "suggest": {
        "mvdnbrk/postmark-inbound": "Allows you to process Postmark Inbound Webhooks."
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0-dev"
        },
        "laravel": {
            "providers": [
                "CraigPaul\\Mail\\PostmarkServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "CraigPaul\\Mail\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CraigPaul\\Mail\\Tests\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
