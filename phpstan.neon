includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - .

    level: 8

    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: true

    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: app/Plugins/Zoho/Integrations/Campaigns/config/zoho_campaigns.php
        -
            identifier: property.notFound
            message: '#property Illuminate\\Contracts\\Auth\\Authenticatable#'
        -
            identifier: property.notFound
            message: '#property Illuminate\\Database\\Eloquent\\Model::#'
        -
            identifier: property.notFound
            message: '#property Razorpay\\Api\\Api::#' 


    excludePaths:
        - vendor/*
        - node_modules/*
        - storage/*
        - bootstrap/cache/*
        - public/*
        - tests
        - app/License/tests
        - lang
        - resources/lang (?)
        - resources/views (?)
        # IDE helper stubs — cause Larastan circular type resolution
        - _ide_helper.php
        - .phpstorm.meta.php (?)
